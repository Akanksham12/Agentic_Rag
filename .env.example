# ----------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is gitignored — never commit real keys.
# Every value below has a safe default in app/config.py; this file documents
# the full set of knobs.
# ----------------------------------------------------------------------------

# --- LLM provider selection -------------------------------------------------
# "ollama" (default, free, local) or "groq" (free-tier cloud, for the demo).
LLM_PROVIDER=ollama

# Local Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b          # upgrade to llama3.1:8b for higher quality

# Groq cloud (used when LLM_PROVIDER=groq). Key comes from env ONLY.
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings (always local & free, regardless of LLM_PROVIDER) -----------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store -----------------------------------------------------------
CHROMA_DIR=./.chroma
COLLECTION_NAME=documents

# --- Chunking ---------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval / agent behaviour --------------------------------------------
TOP_K=4
MAX_ATTEMPTS=2                    # total retrieval tries (1 = no reformulation)
ENABLE_GROUNDING_CHECK=true       # runtime faithfulness gate

# --- Corpus -----------------------------------------------------------------
CORPUS_DIR=./data/corpus

# --- Evaluation -------------------------------------------------------------
# Provider used as the LLM judge. Defaults to "groq" for credible scores even
# when the answering model is a small local one. Falls back to LLM_PROVIDER if
# groq is unavailable.
JUDGE_PROVIDER=groq

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
